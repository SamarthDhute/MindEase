{
  "framework": "vite",
  "headers": [
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
